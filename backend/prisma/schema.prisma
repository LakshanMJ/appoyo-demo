generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  COORDINATOR
  CAREGIVER
}

enum ShiftCategory {
  PERSONAL_CARE
  CLINICAL
  DOMESTIC
  COMMUNITY
  RESPITE
}

enum ShiftType {
  assistance
  transport
  domestic
  community
  nursing
}

enum ShiftStatus {
  CONFIRMED
  PENDING_APPROVAL
  CANCELLED
  COMPLETED
}

model User {
  id             String       @id @default(uuid())

  name     String
  email    String   @unique
  password String?
  role     UserRole

  caregiver Caregiver?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Participant {
  id             String       @id @default(uuid())

  firstName    String
  lastName    String
  phone   String?
  addressLine1 String?
  addressLine2 String?
  allocatedBudget Int @default(0)
  
  shifts Shift[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firstName])
  @@index([lastName])
}

model Caregiver {
  id             String       @id @default(uuid())

  userId String? @unique // Added @unique for 1:1 relation consistency
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  name  String
  phone String?
  avatarUrl String?

  shifts Shift[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Shift {
  id             String       @id @default(uuid())

  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  caregiverId String? // Nullable for Vacant Shifts
  caregiver   Caregiver? @relation(fields: [caregiverId], references: [id], onDelete: SetNull)

  startTime DateTime
  endTime   DateTime

  category ShiftCategory @default(PERSONAL_CARE)
  type     ShiftType     @default(assistance)

  badgeText String?
  badgeIcon String?

  status ShiftStatus @default(PENDING_APPROVAL)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite Indexes for Query Optimization
  @@index([startTime, endTime])
  @@index([caregiverId, startTime, endTime])
  @@index([participantId, startTime, endTime])
  @@index([status])
  @@index([category])
}
