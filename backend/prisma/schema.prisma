generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  COORDINATOR
  CAREGIVER
}

enum ShiftCategory {
  PERSONAL_CARE
  CLINICAL
  DOMESTIC
  COMMUNITY
  RESPITE
}

enum ShiftType {
  ASSISTANCE
  NURSING
  TRAVEL_TRANSPORT
  MEAL_PREP
  DOMESTIC
}

enum ShiftStatus {
  CONFIRMED
  PENDING_APPROVAL
  CANCELLED
  COMPLETED
}

model Organization {
  id   String @id @default(uuid())
  name String

  users        User[]
  participants Participant[]
  caregivers   Caregiver[]
  shifts       Shift[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  email    String   @unique
  password String?
  role     UserRole

  caregiver Caregiver?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([role])
}

model Participant {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  phone   String?
  address String?

  shifts Shift[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([name])
}

model Caregiver {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String? @unique // Added @unique for 1:1 relation consistency
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  name  String
  phone String?

  shifts Shift[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([name])
}

model Shift {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  caregiverId String? // Nullable for Vacant Shifts
  caregiver   Caregiver? @relation(fields: [caregiverId], references: [id], onDelete: SetNull)

  startTime DateTime
  endTime   DateTime

  category ShiftCategory @default(PERSONAL_CARE)
  type     ShiftType     @default(ASSISTANCE)

  badgeText String?
  badgeIcon String?

  status ShiftStatus @default(PENDING_APPROVAL)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite Indexes for Query Optimization
  @@index([organizationId, startTime, endTime])
  @@index([caregiverId, startTime, endTime])
  @@index([participantId, startTime, endTime])
  @@index([organizationId, status])
  @@index([organizationId, category])
}
